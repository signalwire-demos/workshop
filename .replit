entrypoint = "examples/01-ai-agent/python/app.py"
modules = ["python-3.12:v3"]
hidden = [".gitignore", "**/__pycache__"]

run = ["bash", "-c", "cd examples/01-ai-agent/python && pip install -q -r requirements.txt && python app.py"]

[env]
PYTHONUNBUFFERED = "1"

[[ports]]
localPort = 8000
externalPort = 80
