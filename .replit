run = "cd examples/01-ai-agent/python && pip install -r requirements.txt && python app.py"
entrypoint = "examples/01-ai-agent/python/app.py"

[nix]
channel = "stable-24_05"

[env]
PYTHONUNBUFFERED = "1"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
run = ["sh", "-c", "cd examples/01-ai-agent/python && python app.py"]
deploymentTarget = "cloudrun"
