# Optional: paste creds here to skip the UI form. The UI flow is preferred.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_SPACE=yourname.signalwire.com
SIGNALWIRE_API_TOKEN=
PORT=8000

# Agent webhook basic auth.
# Defaults (workshop / workshop-demo) are baked into agent.py so the
# Replit "Wire to agent" flow keeps working across restarts. Override
# here for anything other than workshop demos.
# SWML_BASIC_AUTH_USER=workshop
# SWML_BASIC_AUTH_PASSWORD=workshop-demo
